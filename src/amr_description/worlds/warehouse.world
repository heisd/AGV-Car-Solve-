<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="warehouse">

    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <physics name="default_physics" default="0" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- Warehouse outer walls (14m x 14m interior, 3m tall) -->
    <model name="warehouse_building">
      <static>true</static>
      <link name="walls">
        <collision name="north_col"><pose>0 7 1.5 0 0 0</pose><geometry><box><size>14.4 0.2 3</size></box></geometry></collision>
        <visual name="north_vis"><pose>0 7 1.5 0 0 0</pose><geometry><box><size>14.4 0.2 3</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
        <collision name="south_col"><pose>0 -7 1.5 0 0 0</pose><geometry><box><size>14.4 0.2 3</size></box></geometry></collision>
        <visual name="south_vis"><pose>0 -7 1.5 0 0 0</pose><geometry><box><size>14.4 0.2 3</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
        <collision name="east_col"><pose>7 0 1.5 0 0 0</pose><geometry><box><size>0.2 14.4 3</size></box></geometry></collision>
        <visual name="east_vis"><pose>7 0 1.5 0 0 0</pose><geometry><box><size>0.2 14.4 3</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
        <collision name="west_col"><pose>-7 0 1.5 0 0 0</pose><geometry><box><size>0.2 14.4 3</size></box></geometry></collision>
        <visual name="west_vis"><pose>-7 0 1.5 0 0 0</pose><geometry><box><size>0.2 14.4 3</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
      </link>
    </model>

    <!-- 20 storage shelves: 4 rows x 5 columns -->
    <include>
      <name>shelf_00</name>
      <uri>model://bookshelf</uri>
      <pose>-2.0 4.5 0 0 0 0</pose>
    </include>
    <include>
      <name>shelf_01</name>
      <uri>model://bookshelf</uri>
      <pose>-1.0 4.5 0 0 0 0</pose>
    </include>
    <include>
      <name>shelf_02</name>
      <uri>model://bookshelf</uri>
      <pose>0.0 4.5 0 0 0 0</pose>
    </include>
    <include>
      <name>shelf_03</name>
      <uri>model://bookshelf</uri>
      <pose>1.0 4.5 0 0 0 0</pose>
    </include>
    <include>
      <name>shelf_04</name>
      <uri>model://bookshelf</uri>
      <pose>2.0 4.5 0 0 0 0</pose>
      
    </include>
    <include>
      <name>shelf_05</name>
      <uri>model://bookshelf</uri>
      <pose>-2.0 1.5 0 0 0 0</pose>
    </include>
    <include>
      <name>shelf_06</name>
      <uri>model://bookshelf</uri>
      <pose>-1.0 1.5 0 0 0 0</pose>
    </include>
    <include>
      <name>shelf_07</name>
      <uri>model://bookshelf</uri>
      <pose>0.0 1.5 0 0 0 0</pose>
    </include>
    <include>
      <name>shelf_08</name>
      <uri>model://bookshelf</uri>
      <pose>1.0 1.5 0 0 0 0</pose>
    </include>
    <include>
      <name>shelf_09</name>
      <uri>model://bookshelf</uri>
      <pose>2.0 1.5 0 0 0 0</pose>
    </include>
    <include>
      <name>shelf_10</name>
      <uri>model://bookshelf</uri>
      <pose>-2.0 -1.5 0 0 0 0</pose>
    </include>
    <include>
      <name>shelf_11</name>
      <uri>model://bookshelf</uri>
      <pose>-1.0 -1.5 0 0 0 0</pose>
    </include>
    <include>
      <name>shelf_12</name>
      <uri>model://bookshelf</uri>
      <pose>0.0 -1.5 0 0 0 0</pose>
    </include>
    <include>
      <name>shelf_13</name>
      <uri>model://bookshelf</uri>
      <pose>1.0 -1.5 0 0 0 0</pose>
    </include>
    <include>
      <name>shelf_14</name>
      <uri>model://bookshelf</uri>
      <pose>2.0 -1.5 0 0 0 0</pose>
    </include>
    <include>
      <name>shelf_15</name>
      <uri>model://bookshelf</uri>
      <pose>-2.0 -4.5 0 0 0 0</pose>
    </include>
    <include>
      <name>shelf_16</name>
      <uri>model://bookshelf</uri>
      <pose>-1.0 -4.5 0 0 0 0</pose>
    </include>
    <include>
      <name>shelf_17</name>
      <uri>model://bookshelf</uri>
      <pose>0.0 -4.5 0 0 0 0</pose>
    </include>
    <include>
      <name>shelf_18</name>
      <uri>model://bookshelf</uri>
      <pose>1.0 -4.5 0 0 0 0</pose>
    </include>
    <include>
      <name>shelf_19</name>
      <uri>model://bookshelf</uri>
      <pose>2.0 -4.5 0 0 0 0</pose>
    </include>

    <!-- Pickup station (取货点) -->
    <model name="pickup_station">
      <static>true</static>
      <pose>5.5 5.5 0 0 0 0</pose>
      <link name="marker">
        <visual name="pad"><pose>0 0 0.01 0 0 0</pose><geometry><box><size>2.5 2.5 0.02</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Green</name></script></material></visual>
      </link>
    </model>
    <include>
      <name>pickup_pallet</name>
      <uri>model://euro_pallet</uri>
      <pose>5.5 5.5 0 0 0 0</pose>
    </include>
    <include>
      <name>pickup_tote</name>
      <uri>model://grey_tote</uri>
      <pose>5.5 5.5 0.16 0 0 0</pose>
    </include>

    <!-- Charging station (充电站) -->
    <model name="charging_station">
      <static>true</static>
      <pose>-5.5 -5.5 0 0 0 0</pose>
      <link name="link">
        <visual name="pad"><pose>0 0 0.01 0 0 0</pose><geometry><box><size>2.0 2.0 0.02</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script></material></visual>
        <collision name="cab_col"><pose>0 -0.8 0.4 0 0 0</pose><geometry><box><size>0.9 0.4 0.8</size></box></geometry></collision>
        <visual name="cab_vis"><pose>0 -0.8 0.4 0 0 0</pose><geometry><box><size>0.9 0.4 0.8</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Yellow</name></script></material></visual>
        <visual name="post_vis"><pose>0 -0.55 0.25 0 0 0</pose><geometry><box><size>0.12 0.12 0.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Black</name></script></material></visual>
      </link>
    </model>

    <gui>
      <camera name="user_camera">
        <pose>-12 -12 10 0 0.5 0.78</pose>
      </camera>
    </gui>

  </world>
</sdf>
